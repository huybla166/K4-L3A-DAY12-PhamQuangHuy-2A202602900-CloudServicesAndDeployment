# File này quyết định thứ KHÔNG được copy vào image (build context).
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không vào image
.env
.env.*

# Git & môi trường ảo
.git
.gitignore
.venv
venv/

# Cache / file sinh ra khi chạy
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache

# Không cần lúc chạy app
tests
screenshots
.github
nginx
*.md
Dockerfile
docker-compose.yml
railway.toml
render.yaml
grade.py
